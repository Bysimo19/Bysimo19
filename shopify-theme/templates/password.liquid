{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} — Muy pronto</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body style="background:var(--hero-bg);color:var(--hero-fg);min-height:100svh;display:grid;place-items:center;text-align:center">
  <div class="wrap" style="display:grid;gap:28px;justify-items:center">
    <span class="kicker">{{ shop.name }}</span>
    <h1 class="display">Muy<br>pronto</h1>
    <p style="opacity:.7;max-width:420px">{{ shop.password_message }}</p>
    {%- form 'customer', class: 'news__form', style: 'width:min(460px,100%)' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      <input type="email" name="contact[email]" placeholder="tu@email.com" required style="color:var(--hero-fg)">
      <button class="btn btn--accent" type="submit">Avísame</button>
    {%- endform -%}
    <details style="font-size:13px;opacity:.7"><summary style="cursor:pointer">Acceso tienda</summary>
      {%- form 'storefront_password' -%}{{ form.errors | default_errors }}<input type="password" name="password" placeholder="Contraseña" style="margin-top:12px;height:44px;border-radius:99px;border:1px solid;padding:0 16px;background:none"> <button class="btn btn--light" type="submit" style="height:44px">Entrar</button>{%- endform -%}
    </details>
  </div>
</body>
</html>
