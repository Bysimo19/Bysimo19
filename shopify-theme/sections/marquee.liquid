<div class="marquee{% if section.settings.style == 'dark' %} marquee--dark{% endif %}" style="--speed: {{ section.settings.speed }}s" aria-hidden="true">
  <div class="marquee__track">
    {%- assign words = section.settings.text | split: '|' -%}
    {%- for i in (1..2) -%}
      {%- for k in (1..3) -%}
        {%- for w in words -%}
          <span class="marquee__item">{{ w | strip }} {% render 'icon', name: 'star' %}</span>
        {%- endfor -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Cinta de texto",
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "info": "Separa con |", "default": "Jordan | Nike | Adidas | New Balance | Yeezy | Essentials" },
    { "type": "select", "id": "style", "label": "Estilo", "options": [ { "value": "accent", "label": "Acento" }, { "value": "dark", "label": "Oscuro" } ], "default": "accent" },
    { "type": "range", "id": "speed", "label": "Duración del ciclo", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 35 }
  ],
  "presets": [{ "name": "Cinta de texto" }]
}
{% endschema %}
