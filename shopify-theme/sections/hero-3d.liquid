{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
-%}
<section class="hero" data-hero3d data-remove-bg="{{ section.settings.remove_bg }}" aria-label="{{ section.settings.title_1 | escape }} {{ section.settings.title_2 | escape }}">
  <div class="hero__bg" aria-hidden="true"></div>

  <div class="hero__title">
    <h1 class="display">
      <span>{{ section.settings.title_1 }}</span>
      <span>{{ section.settings.title_2 }}</span>
    </h1>
  </div>

  {%- comment -%} Respaldo sin WebGL / mientras carga {%- endcomment -%}
  <div class="hero__fallback" aria-hidden="true">
    {%- for p in source.products limit: 3 -%}
      {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '300,450,600', sizes: '22vw', alt: '' }}{%- endif -%}
    {%- endfor -%}
  </div>

  <canvas class="hero__canvas" tabindex="0" aria-label="Carrusel 3D de productos. Arrastra o usa las flechas para girar; Enter para abrir el producto destacado."></canvas>
  <div class="hero__grain" aria-hidden="true"></div>

  <div class="hero__top">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <span class="hero__count mono" data-hero-count></span>
  </div>

  <div class="hero__ui">
    <div>
      {%- if section.settings.lead != blank -%}<p class="hero__lead">{{ section.settings.lead }}</p>{%- endif -%}
      <div class="hero__ctas">
        {%- if section.settings.cta_1_label != blank -%}<a class="btn btn--light" href="{{ section.settings.cta_1_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_1_label }} <span class="arrow">→</span></a>{%- endif -%}
        {%- if section.settings.cta_2_label != blank -%}<a class="btn btn--ghost" href="{{ section.settings.cta_2_url | default: routes.collections_url }}">{{ section.settings.cta_2_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="hero__hint" aria-hidden="true">Arrastra para girar <i></i></div>
    <div class="hero__focus" data-hero-focus aria-live="polite">
      <a href="#">
        <span class="hero__focus-label">En foco</span>
        <span class="hero__focus-title" data-f-title></span>
        <span class="hero__focus-price mono" data-f-price></span>
      </a>
    </div>
  </div>

  <script type="application/json" data-hero-items>
    [
    {%- for p in source.products limit: section.settings.limit -%}
      {%- liquid
        assign img = nil
        if p.featured_image
          assign img = p.featured_image | image_url: width: 640
        endif
        assign compare = nil
        assign badge = nil
        if p.compare_at_price > p.price
          assign compare = p.compare_at_price | money | strip_html
          assign off = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price
          assign badge = '-' | append: off | append: '%'
        endif
      -%}
      {"img": {{ img | json }}, "title": {{ p.title | json }}, "url": {{ p.url | json }}, "price": {{ p.price | money | strip_html | json }}, "compare": {{ compare | json }}, "badge": {{ badge | json }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  </script>
</section>
<script src="{{ 'hero-3d.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero 3D",
  "class": "hero-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Colección del anillo 3D", "info": "Se usan las fotos principales. Mejor con fondo uniforme. Vacío = todos los productos." },
    { "type": "checkbox", "id": "remove_bg", "label": "Quitar fondo liso de las fotos automáticamente", "info": "Para el mejor resultado sube fotos PNG sin fondo (en Shopify: editar imagen → Quitar fondo).", "default": true },
    { "type": "range", "id": "limit", "label": "Productos en el anillo", "min": 6, "max": 14, "step": 1, "default": 12 },
    { "type": "text", "id": "kicker", "label": "Etiqueta superior", "default": "Drop 07 — Otoño/Invierno 26" },
    { "type": "text", "id": "title_1", "label": "Titular línea 1", "default": "Nueva" },
    { "type": "text", "id": "title_2", "label": "Titular línea 2 (contorno)", "default": "Temporada" },
    { "type": "textarea", "id": "lead", "label": "Texto", "default": "Pares verificados uno a uno. Stock real, envío en 24/48 h desde España." },
    { "type": "text", "id": "cta_1_label", "label": "Botón 1", "default": "Comprar ahora" },
    { "type": "url", "id": "cta_1_url", "label": "Enlace botón 1" },
    { "type": "text", "id": "cta_2_label", "label": "Botón 2", "default": "Categorías" },
    { "type": "url", "id": "cta_2_url", "label": "Enlace botón 2" }
  ],
  "presets": [{ "name": "Hero 3D" }]
}
{% endschema %}
